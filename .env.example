# WPGraphQL endpoint of the headless WordPress.
WP_GRAPHQL_URL=https://vilaxheadless.staging.vilax.es/graphql

# Data source rules (src/lib/wp/source.ts):
#   - WP_GRAPHQL_URL set           → WordPress data; any missing menu / query error fails the build.
#   - unset, `astro dev`           → mock data (menus) with a warning.
#   - unset, `astro build`         → build FAILS, unless WP_USE_MOCKS=true (preview builds only).
# WP_USE_MOCKS=true

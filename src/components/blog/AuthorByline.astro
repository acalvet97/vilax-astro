---
/**
 * "Publicado por …" with photo and job title (Figma 2034:755).
 */
import { Image } from 'astro:assets';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import type { PostCard } from '../../lib/blog';

type Props = { author: NonNullable<PostCard['author']>; locale: Locale; class?: string };

const { author, locale, class: className } = Astro.props;
const t = useTranslations(locale);
---

<div class:list={['flex items-center gap-lg', className]}>
  {
    author.photo && (
      <Image
        src={author.photo.src}
        alt=""
        width={52}
        height={52}
        densities={[1, 2]}
        class="size-[3.25rem] shrink-0 rounded-full object-cover"
      />
    )
  }
  <div class="flex min-w-0 flex-col gap-3xs">
    <p class="t-body-lg">{t('blog.publishedBy')} {author.name}</p>
    {author.jobTitle && <p class="t-body-sm text-text-muted">{author.jobTitle}</p>}
  </div>
</div>

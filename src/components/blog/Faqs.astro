---
/**
 * Blog article FAQs (Figma "FAQs", 2034:714): grey box with the "FAQs" heading
 * and the shared accordion. Items come from the ACF repeater.
 */
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import type { FaqItem } from '../../lib/faq';
import FaqAccordion from '../ui/FaqAccordion.astro';

type Props = {
  items: FaqItem[];
  locale: Locale;
  class?: string;
};

const { items, locale, class: className } = Astro.props;
const t = useTranslations(locale);
---

{
  items.length > 0 && (
    <section aria-labelledby="faqs-title" class:list={['flex flex-col gap-xl bg-bg-alt p-xl lg:p-2xl', className]}>
      <h2 id="faqs-title" class="t-heading-lg lg:t-heading-xl">
        {t('blog.faqs')}
      </h2>
      <FaqAccordion items={items} surface="alt" />
    </section>
  )
}

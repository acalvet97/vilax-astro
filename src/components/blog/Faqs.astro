---
/**
 * FAQs accordion (Figma "FAQs", 2034:714). Native <details>/<summary>:
 * accessible and works without JavaScript. The first question starts open,
 * as in the design.
 */
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

type Props = {
  items: Array<{ question: string; answer: string }>;
  locale: Locale;
  class?: string;
};

const { items, locale, class: className } = Astro.props;
const t = useTranslations(locale);
---

{
  items.length > 0 && (
    <section aria-labelledby="faqs-title" class:list={['flex flex-col gap-xl bg-bg-alt p-xl lg:p-2xl', className]}>
      <h2 id="faqs-title" class="t-heading-lg lg:t-heading-xl">
        {t('blog.faqs')}
      </h2>
      <div>
        {items.map((item, i) => (
          <details class="group border-b border-border py-xl" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-md [&::-webkit-details-marker]:hidden">
              <h3 class="t-heading-sm">{item.question}</h3>
              <span class="flex size-[2.25rem] shrink-0 items-center justify-center bg-bg" aria-hidden="true">
                <Icon name="ri:add-fill" class="size-sm group-open:hidden" />
                <Icon name="ri:subtract-fill" class="hidden size-sm group-open:block" />
              </span>
            </summary>
            <div class="t-body-lg mt-xl [&_a]:underline [&_p+p]:mt-sm" set:html={item.answer} />
          </details>
        ))}
      </div>
    </section>
  )
}

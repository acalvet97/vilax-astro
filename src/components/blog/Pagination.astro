---
/**
 * Numbered pagination (Figma 2034:3504). Current page has the bg-alt pill.
 */
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { pagePath } from '../../lib/blog';

type Props = { page: number; totalPages: number; basePath: string; locale: Locale; class?: string };

const { page, totalPages, basePath, locale, class: className } = Astro.props;
const t = useTranslations(locale);
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
---

{
  totalPages > 1 && (
    <nav aria-label={t('pagination.label')} class={className}>
      <ul class="flex flex-wrap items-center gap-xs">
        {pages.map((n) => (
          <li>
            <a
              href={pagePath(basePath, n)}
              aria-current={n === page ? 'page' : undefined}
              aria-label={`${t('pagination.page')} ${n}`}
              class:list={[
                't-caption flex min-w-[2rem] items-center justify-center rounded-full px-xs py-2xs',
                n === page ? 'bg-bg-alt' : 'hover:bg-bg-alt',
              ]}
            >
              {n}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

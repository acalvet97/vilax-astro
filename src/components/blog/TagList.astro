---
/**
 * Pill list (Figma "Tag_list", 2034:3411 / 2034:748). Used for category
 * filters on the blog archive and the categories of an article.
 */
type Item = { label: string; href: string; current?: boolean };

type Props = {
  items: Item[];
  /** Archive filters are uppercase in Figma; article pills are not. */
  uppercase?: boolean;
  label?: string;
};

const { items, uppercase = false, label } = Astro.props;
---

{
  items.length > 0 && (
    <ul class="flex flex-wrap items-center gap-xs" aria-label={label}>
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={item.current ? 'page' : undefined}
            class:list={[
              't-caption inline-flex items-center rounded-full px-sm py-2xs',
              uppercase && 'uppercase',
              item.current ? 'bg-accent text-text-on-accent' : 'bg-bg-alt hover:bg-bg-alt-hover',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  )
}

---
/**
 * Form field with the label sitting on the top border (Figma "FormField";
 * design "Formulario", 2034:8593). Light border at rest, strong border on focus
 * (no outline). The error message stays hidden until the form script
 * (src/scripts/contact-form.ts) shows it.
 */
import { Icon } from 'astro-icon/components';

type Props = {
  name: string;
  label: string;
  error: string;
  placeholder?: string;
  type?: 'text' | 'email' | 'tel';
  autocomplete?: string;
  required?: boolean;
  minlength?: number;
  maxlength?: number;
  multiline?: boolean;
};

const { name, label, error, type = 'text', multiline = false, ...attrs } = Astro.props;
const id = `contact-${name}`;
const errorId = `${id}-error`;
const fieldClass =
  't-body-md block w-full border border-border bg-bg px-xl py-sm text-text transition-colors duration-200 placeholder:text-text-subtle focus:border-border-strong';
---

<div>
  <div class="relative">
    <label for={id} class="t-label-sm absolute top-[-0.5rem] left-[0.625rem] bg-bg px-2xs uppercase">
      {label}
    </label>
    {
      multiline ? (
        <textarea id={id} name={name} rows={3} aria-describedby={errorId} class:list={[fieldClass, 'resize-y']} {...attrs} />
      ) : (
        <input id={id} name={name} type={type} aria-describedby={errorId} class={fieldClass} {...attrs} />
      )
    }
  </div>
  <p id={errorId} data-field-error={name} class="t-caption mt-2xs flex items-center gap-3xs" hidden>
    <Icon name="ri:error-warning-line" class="size-sm shrink-0" aria-hidden="true" />
    <span>{error}</span>
  </p>
</div>

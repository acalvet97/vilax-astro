---
/**
 * FAQ accordion (Figma "FAQs", 2034:714 and 2034:8633). Native <details>/<summary>:
 * accessible and works without JavaScript. The first question starts open,
 * as in the design. Hovering or focusing the question row turns the toggle
 * square accent (library "FaqItem").
 *
 * `surface` is the background the accordion sits on:
 *   - 'alt'  (blog article box, bg-alt): white toggle, answer in body color
 *   - 'base' (page sections, white):     bg-alt toggle, answer muted
 */
import { Icon } from 'astro-icon/components';
import type { FaqItem } from '../../lib/faq';

type Props = {
  items: FaqItem[];
  surface?: 'alt' | 'base';
  class?: string;
};

const { items, surface = 'alt', class: className } = Astro.props;
---

<div class={className}>
  {
    items.map((item, i) => (
      <details class="group border-b border-border py-xl" open={i === 0}>
        <summary class="group/q flex cursor-pointer list-none items-center justify-between gap-md [&::-webkit-details-marker]:hidden">
          <h3 class="t-heading-sm">{item.question}</h3>
          <span
            class:list={[
              'flex size-[2.25rem] shrink-0 items-center justify-center transition-colors duration-200',
              'group-hover/q:bg-accent group-hover/q:text-text-on-accent',
              surface === 'alt' ? 'bg-bg' : 'bg-bg-alt',
            ]}
            aria-hidden="true"
          >
            <Icon name="ri:add-fill" class="size-sm group-open:hidden" />
            <Icon name="ri:subtract-fill" class="hidden size-sm group-open:block" />
          </span>
        </summary>
        <div
          class:list={['t-body-lg mt-xl [&_a]:underline [&_p+p]:mt-sm', surface === 'base' && 'text-text-muted']}
          set:html={item.answer}
        />
      </details>
    ))
  }
</div>

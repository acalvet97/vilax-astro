---
/**
 * Primary button (Figma "hero__main--button-primary"): accent fill; on hover,
 * transparent with a border in the text color (same as the header Contact
 * button on light surfaces). Renders <a> with `href`, otherwise <button>.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = (HTMLAttributes<'a'> & { href: string }) | (HTMLAttributes<'button'> & { href?: undefined });

const { class: className, ...attrs } = Astro.props;
const classes = [
  't-label inline-flex items-center justify-center border border-accent bg-accent px-xl py-sm uppercase text-text-on-accent transition-colors duration-300 hover:border-text hover:bg-transparent hover:text-text disabled:pointer-events-none disabled:opacity-60',
  className,
];
---

{
  'href' in attrs && attrs.href !== undefined ? (
    <a class:list={classes} {...(attrs as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <button type="button" class:list={classes} {...(attrs as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}

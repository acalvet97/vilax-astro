---
/**
 * Social profile links (Figma "SocialTile"): accent IconTiles with Remix icons.
 * Destinations and order: src/config/site.ts.
 */
import { socialLinks, type SocialNetwork } from '../../config/site';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import IconTile from '../ui/IconTile.astro';

type Props = { locale: Locale };

const { locale } = Astro.props;
const t = useTranslations(locale);

const icons: Record<SocialNetwork, string> = {
  linkedin: 'ri:linkedin-fill',
  instagram: 'ri:instagram-line',
  facebook: 'ri:facebook-fill',
  tiktok: 'ri:tiktok-fill',
  behance: 'ri:behance-fill',
  youtube: 'ri:youtube-fill',
};
---

<ul class="flex flex-wrap items-center gap-xs" aria-label={t('footer.social')}>
  {
    socialLinks.map(({ network, label, href }) => (
      <li>
        <IconTile href={href} label={label} icon={icons[network]} tone="accent" />
      </li>
    ))
  }
</ul>

---
/**
 * Social profile links. Destinations and order: src/config/site.ts.
 * Each link is a 2.5rem accent tile; the glyph is 1rem.
 */
import { socialLinks, type SocialNetwork } from '../../config/site';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import Behance from '../../icons/social/behance.svg';
import Facebook from '../../icons/social/facebook.svg';
import Instagram from '../../icons/social/instagram.svg';
import Linkedin from '../../icons/social/linkedin.svg';
import Tiktok from '../../icons/social/tiktok.svg';
import Youtube from '../../icons/social/youtube.svg';

type Props = { locale: Locale };

const { locale } = Astro.props;
const t = useTranslations(locale);

const icons: Record<SocialNetwork, typeof Linkedin> = {
  linkedin: Linkedin,
  instagram: Instagram,
  facebook: Facebook,
  tiktok: Tiktok,
  behance: Behance,
  youtube: Youtube,
};
---

<ul class="flex flex-wrap items-center gap-xs" aria-label={t('footer.social')}>
  {
    socialLinks.map(({ network, label, href }) => {
      const SocialIcon = icons[network];
      return (
        <li>
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label}
            class="flex size-[2.5rem] items-center justify-center bg-accent text-text hover:opacity-80"
          >
            <SocialIcon class="size-sm" aria-hidden="true" />
          </a>
        </li>
      );
    })
  }
</ul>

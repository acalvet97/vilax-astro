---
/**
 * Language switcher, segmented as in production ("ES · CA · EN", all visible,
 * current one highlighted). Links to the current page's translation when it
 * exists, otherwise to the home page of that language.
 */
import { localeMeta, locales, type Locale } from '../../i18n/config';
import { getRoutePath, type Alternate } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';

type Props = {
  locale: Locale;
  alternates?: Alternate[];
  surface?: 'light' | 'dark';
  class?: string;
};

const { locale, alternates = [], surface = 'dark', class: className } = Astro.props;
const t = useTranslations(locale);
const dark = surface === 'dark';

const options = locales.map((l) => ({
  locale: l,
  href: alternates.find((a) => a.locale === l)?.href ?? getRoutePath('home', l),
  ...localeMeta[l],
}));
---

<ul
  aria-label={t('nav.language')}
  class:list={[
    'flex min-h-[calc(var(--spacing-xl)+1.2*var(--text-md)+2px)] gap-[2px] p-3xs',
    dark ? 'bg-bg-inverse-alt' : 'bg-bg-alt',
    className,
  ]}
>
  {
    options.map((o) => (
      <li class="flex">
        <a
          href={o.href}
          hreflang={o.hreflang}
          lang={o.hreflang}
          aria-current={o.locale === locale ? 'true' : undefined}
          class:list={[
            't-label flex items-center px-xs py-2xs uppercase transition-colors duration-200',
            dark ? 'hover:bg-bg-inverse aria-[current]:bg-bg-inverse' : 'hover:bg-bg aria-[current]:bg-bg',
          ]}
        >
          {o.short}
          <span class="sr-only">{o.label}</span>
        </a>
      </li>
    ))
  }
</ul>

---
/**
 * Site header — replicates the production header (wordpress/reference/production-header)
 * with the project's design tokens and text styles.
 *
 *  - Sticky at the top. Dark by default; light on blog, cases, archives… (see header-theme.ts).
 *  - Desktop (≥1025px): logo, WordPress `primary` menu, language switcher, Contact.
 *      · item with 3 levels (Servicios) → mega menu (MegaMenu.astro)
 *      · item with children             → dropdown
 *      · other items                    → link
 *  - Mobile/tablet (≤1024px): burger → level-based panel (MobileDrawer.astro).
 * Interactions: src/scripts/header.ts.
 */
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../i18n/config';
import { getRoutePath, type Alternate } from '../../i18n/routes';
import { useTranslations } from '../../i18n/ui';
import { getMenu, isActive, isMegaItem } from '../../lib/navigation';
import MenuLink from '../navigation/MenuLink.astro';
import Button from '../ui/Button.astro';
import { headerTheme, type HeaderSurface } from './header-theme';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import MegaMenu from './MegaMenu.astro';
import MobileDrawer from './MobileDrawer.astro';

type Props = {
  locale: Locale;
  alternates?: Alternate[];
  surface?: HeaderSurface;
};

const { locale, alternates, surface = 'dark' } = Astro.props;
const t = useTranslations(locale);
const primary = await getMenu('primary', locale);
const currentPath = Astro.url.pathname;
const theme = headerTheme(surface);

const navLink = [
  'group t-label inline-flex items-center gap-3xs uppercase whitespace-nowrap transition-colors duration-200',
  theme.hoverMuted,
];
const dropdownLink = ['t-label block whitespace-nowrap px-sm py-2xs uppercase', theme.hoverMuted];
---

<header class="sticky top-0 z-50">
  <div class:list={['relative border-b', theme.surface, theme.border]} data-header>
    <a
      href="#main"
      class="t-label sr-only bg-accent px-sm py-2xs text-text-on-accent focus:not-sr-only focus:absolute focus:top-2xs focus:left-2xs focus:z-10"
    >
      {t('nav.skipToContent')}
    </a>

    <div class="wrapper flex min-h-[var(--header-height)] items-center justify-between gap-xl">
      <a href={getRoutePath('home', locale)} aria-label={t('nav.home')} class="shrink-0">
        <Logo color={surface === 'dark' ? 'white' : 'black'} />
      </a>

      <!-- Desktop navigation -->
      <nav aria-label={t('nav.main')} class="hidden lg:block">
        <ul class="flex items-center gap-xl">
          {
            primary.map((item, i) => {
              if (item.children.length === 0) {
                return (
                  <li>
                    <MenuLink item={item} currentPath={currentPath} class:list={navLink} />
                  </li>
                );
              }
              const panelId = `nav-panel-${i}`;
              const mega = isMegaItem(item);
              return (
                <li data-nav-item class:list={[!mega && 'relative']}>
                  <button
                    type="button"
                    data-nav-toggle
                    aria-expanded="false"
                    aria-controls={panelId}
                    class:list={[navLink, isActive(item, currentPath) && 'underline underline-offset-4']}
                  >
                    {item.label}
                    <Icon
                      name="ri:arrow-down-s-line"
                      class="size-sm transition-transform duration-200 group-aria-expanded:rotate-180"
                      aria-hidden="true"
                    />
                  </button>
                  {mega ? (
                    <MegaMenu id={panelId} groups={item.children} locale={locale} theme={theme} currentPath={currentPath} />
                  ) : (
                    <ul
                      id={panelId}
                      hidden
                      class:list={['absolute top-full left-0 mt-sm min-w-full border py-2xs', theme.surface, theme.border]}
                    >
                      {item.href && (
                        <li>
                          <MenuLink item={item} currentPath={currentPath} class:list={dropdownLink} />
                        </li>
                      )}
                      {item.children.map((link) => (
                        <li>
                          <MenuLink item={link} currentPath={currentPath} class:list={dropdownLink} />
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              );
            })
          }
        </ul>
      </nav>

      <div class="flex items-stretch gap-sm">
        <LanguageSwitcher locale={locale} alternates={alternates} surface={surface} class="hidden lg:flex" />
        <div class="hidden lg:flex">
          <Button href={getRoutePath('contact', locale)} surface={surface}>{t('nav.contact')}</Button>
        </div>

        <!-- Burger (mobile/tablet) -->
        <button
          type="button"
          data-drawer-open
          aria-expanded="false"
          aria-controls="site-drawer"
          aria-label={t('nav.openMenu')}
          class="relative inline-flex size-[44px] items-center justify-end lg:hidden"
        >
          <span
            aria-hidden="true"
            class="relative block h-[2px] w-lg bg-current before:absolute before:-top-[7px] before:left-0 before:h-[2px] before:w-lg before:bg-current after:absolute after:top-[7px] after:left-0 after:h-[2px] after:w-lg after:bg-current"
          ></span>
        </button>
      </div>
    </div>

    <MobileDrawer
      id="site-drawer"
      items={primary}
      locale={locale}
      alternates={alternates}
      surface={surface}
      theme={theme}
      currentPath={currentPath}
    />
  </div>
</header>

<script>
  import '../../scripts/header';
</script>

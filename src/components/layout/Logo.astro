---
/**
 * VILAX wordmark (production logo files, tightly cropped, ratio ≈ 4.1:1).
 * Same size everywhere (header, mobile menu, footer), as in production:
 * 108px mobile → 124px tablet → 135px desktop.
 * TODO: replace with an SVG logo when available (sharper, lighter).
 */
import { Image } from 'astro:assets';
import logoBlack from '../../assets/brand/logo-black.png';
import logoWhite from '../../assets/brand/logo-white.png';

type Props = {
  color?: 'black' | 'white';
  /** `eager` only for the header logo (above the fold). */
  loading?: 'eager' | 'lazy';
  class?: string;
};

const { color = 'black', loading = 'eager', class: className } = Astro.props;
const src = color === 'white' ? logoWhite : logoBlack;
---

<Image
  src={src}
  alt="VILAX"
  width={135}
  densities={[1, 2]}
  loading={loading}
  fetchpriority={loading === 'eager' ? 'high' : undefined}
  class:list={['block h-auto w-[108px] md:w-[124px] lg:w-[135px]', className]}
/>

---
/**
 * Blog archive and category archives (Figma "ArchivoBlog", 2034:3381).
 * Category archives reuse it with the category's pill marked as current.
 */
import PostCard from '../components/blog/PostCard.astro';
import Pagination from '../components/blog/Pagination.astro';
import TagList from '../components/blog/TagList.astro';
import { useTranslations } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import { toPostCard, type ArchiveProps } from '../lib/blog';

type Props = Omit<ArchiveProps, 'template'>;

const { locale, posts, page, totalPages, basePath, categories, category, alternates } = Astro.props;
const t = useTranslations(locale);
const cards = await Promise.all(posts.map(toPostCard));

const heading = category ? category.data.name : t('blog.title');
const baseTitle = category?.data.seo.title ?? `${heading} | VILAX`;
const title = page > 1 ? `${baseTitle} – ${t('pagination.page')} ${page}` : baseTitle;

const pills = categories.map((c) => ({ label: c.data.name, href: c.data.path, current: c.id === category?.id }));
---

<BaseLayout
  locale={locale}
  title={title}
  description={category?.data.seo.description}
  noindex={category?.data.seo.noindex}
  alternates={alternates}
>
  <div class="px-page flex flex-col gap-4xl pt-4xl pb-6xl lg:pt-6xl">
    <header class="flex flex-col gap-2xl">
      <h1 class="t-display-sm lg:t-display-lg">{heading}</h1>
      <TagList items={pills} uppercase label={t('blog.categories')} />
    </header>

    {
      cards.length > 0 ? (
        <div class="grid gap-x-md gap-y-3xl lg:grid-cols-2 lg:gap-y-6xl">
          {cards.map((card) => (
            <PostCard card={card} locale={locale} />
          ))}
        </div>
      ) : (
        <p class="t-body-lg text-text-muted">{t('blog.empty')}</p>
      )
    }

    <Pagination page={page} totalPages={totalPages} basePath={basePath} locale={locale} />
  </div>
</BaseLayout>
